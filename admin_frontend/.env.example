# SafeClick Admin Dashboard Environment Variables
# Copy this file to .env or .env.local for development
# Copy to .env.production for production builds

# API Base URL (Must point to the Django backend)
# For local development (using Vite proxy, you can omit this or point it directly to the proxy path if needed)
# Example: VITE_API_URL=http://localhost:9000/api
VITE_API_URL=http://localhost:9000/api

# For production, set this to the actual production backend URL
# VITE_API_URL=https://api.safeclick.io/api
